---
// "Guess the Price of the Card" — standalone mechanics prototype.
// Uses placeholder cards from src/data/cards.ts. Once the GoDaddy product
// CSV is imported, swap CARDS for real inventory (id, title, price, image).
import { CATEGORY_LABELS } from "../data/cards";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Guess the Price</title>
		<style>
			:root {
				color-scheme: dark;
				--bg: #0b0c10;
				--panel: #16181f;
				--panel-border: #262a35;
				--text: #f4f5f7;
				--muted: #9aa0ac;
				--accent: #f4b731;
				--good: #4ade80;
				--bad: #f87171;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				min-height: 100vh;
				background: var(--bg);
				color: var(--text);
				font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
				display: flex;
				justify-content: center;
				padding: 2.5rem 1.25rem 4rem;
			}

			main {
				width: 100%;
				max-width: 480px;
			}

			header {
				text-align: center;
				margin-bottom: 1.5rem;
			}

			h1 {
				font-size: 1.6rem;
				margin: 0 0 0.35rem;
			}

			header p {
				color: var(--muted);
				margin: 0;
				font-size: 0.92rem;
			}

			a.back {
				color: var(--muted);
				font-size: 0.85rem;
				text-decoration: none;
			}
			a.back:hover {
				color: var(--text);
			}

			.stats {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.6rem;
				margin: 1.25rem 0;
			}

			.stat {
				background: var(--panel);
				border: 1px solid var(--panel-border);
				border-radius: 10px;
				padding: 0.6rem 0.5rem;
				text-align: center;
			}

			.stat .value {
				font-size: 1.25rem;
				font-weight: 700;
			}

			.stat .label {
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--muted);
			}

			.card-panel {
				background: var(--panel);
				border: 1px solid var(--panel-border);
				border-radius: 16px;
				overflow: hidden;
			}

			.card-art {
				height: 220px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 4.5rem;
				position: relative;
			}

			.badge {
				position: absolute;
				top: 0.75rem;
				left: 0.75rem;
				background: rgba(0, 0, 0, 0.45);
				padding: 0.25rem 0.6rem;
				border-radius: 999px;
				font-size: 0.72rem;
				letter-spacing: 0.03em;
			}

			.card-body {
				padding: 1.1rem 1.25rem 1.3rem;
			}

			.card-body h2 {
				margin: 0 0 0.2rem;
				font-size: 1.2rem;
			}

			.card-body .subtitle {
				color: var(--muted);
				font-size: 0.85rem;
				margin: 0;
			}

			.guess-row {
				display: flex;
				gap: 0.6rem;
				margin-top: 1.1rem;
			}

			.guess-row .prefix {
				display: flex;
				align-items: center;
				padding: 0 0.5rem;
				background: #1d2029;
				border: 1px solid var(--panel-border);
				border-radius: 10px 0 0 10px;
				border-right: none;
				color: var(--muted);
			}

			input[type="number"] {
				flex: 1;
				min-width: 0;
				background: #1d2029;
				border: 1px solid var(--panel-border);
				border-left: none;
				border-radius: 0 10px 10px 0;
				color: var(--text);
				font-size: 1rem;
				padding: 0.6rem 0.7rem;
			}
			input[type="number"]:focus {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}

			button {
				border: none;
				border-radius: 10px;
				padding: 0.7rem 1rem;
				font-size: 0.95rem;
				font-weight: 600;
				cursor: pointer;
			}

			#guess-btn {
				margin-top: 0.7rem;
				width: 100%;
				background: var(--accent);
				color: #201a03;
			}
			#guess-btn:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}

			#next-btn {
				margin-top: 0.7rem;
				width: 100%;
				background: #2a2e3a;
				color: var(--text);
			}

			.result {
				margin-top: 1rem;
				border-top: 1px dashed var(--panel-border);
				padding-top: 1rem;
				display: none;
			}

			.result.visible {
				display: block;
			}

			.result-row {
				display: flex;
				justify-content: space-between;
				font-size: 0.9rem;
				margin-bottom: 0.35rem;
			}

			.result-row .val {
				font-weight: 600;
			}

			.feedback {
				text-align: center;
				font-size: 1.05rem;
				font-weight: 700;
				margin: 0.6rem 0 0.2rem;
			}

			.feedback.good {
				color: var(--good);
			}
			.feedback.bad {
				color: var(--bad);
			}

			.hidden {
				display: none !important;
			}
		</style>
	</head>
	<body>
		<main>
			<header>
				<a class="back" href="/">← back</a>
				<h1>🎯 Guess the Price</h1>
				<p>See the card. Guess what it's worth. Chase the streak.</p>
			</header>

			<div class="stats">
				<div class="stat">
					<div class="value" id="stat-score">–</div>
					<div class="label">Last score</div>
				</div>
				<div class="stat">
					<div class="value" id="stat-streak">0 🔥</div>
					<div class="label">Streak</div>
				</div>
				<div class="stat">
					<div class="value" id="stat-best">0</div>
					<div class="label">Best streak</div>
				</div>
			</div>

			<div class="card-panel">
				<div class="card-art" id="card-art">
					<span class="badge" id="card-badge"></span>
					<span id="card-icon"></span>
				</div>
				<div class="card-body">
					<h2 id="card-title"></h2>
					<p class="subtitle" id="card-subtitle"></p>

					<div class="guess-row">
						<span class="prefix">$</span>
						<input
							type="number"
							id="guess-input"
							min="0"
							step="1"
							placeholder="Your guess"
							inputmode="numeric"
						/>
					</div>
					<button id="guess-btn">Lock In Guess</button>

					<div class="result" id="result">
						<div class="result-row">
							<span>Your guess</span>
							<span class="val" id="result-guess"></span>
						</div>
						<div class="result-row">
							<span>The comp</span>
							<span class="val" id="result-actual"></span>
						</div>
						<div class="result-row">
							<span>Ratio</span>
							<span class="val" id="result-ratio"></span>
						</div>
						<div class="result-row">
							<span>Points earned</span>
							<span class="val" id="result-score"></span>
						</div>
						<p class="feedback" id="result-feedback"></p>
						<button id="next-btn">Next Card →</button>
					</div>
				</div>
			</div>
		</main>

		<script>
			import { CARDS, CATEGORY_LABELS, type GameCard } from "../data/cards";
			import { computeScore, ratioInWords, STREAK_THRESHOLD } from "../lib/scoring";

			const BEST_STREAK_KEY = "cardgame:bestStreak";

			let deck: GameCard[] = [];
			let current: GameCard | null = null;
			let previousId: string | null = null;
			let streak = 0;
			let bestStreak = Number(localStorage.getItem(BEST_STREAK_KEY) ?? "0");

			const els = {
				score: document.getElementById("stat-score")!,
				streak: document.getElementById("stat-streak")!,
				best: document.getElementById("stat-best")!,
				art: document.getElementById("card-art")!,
				badge: document.getElementById("card-badge")!,
				icon: document.getElementById("card-icon")!,
				title: document.getElementById("card-title")!,
				subtitle: document.getElementById("card-subtitle")!,
				guessInput: document.getElementById("guess-input") as HTMLInputElement,
				guessBtn: document.getElementById("guess-btn") as HTMLButtonElement,
				nextBtn: document.getElementById("next-btn") as HTMLButtonElement,
				result: document.getElementById("result")!,
				resultGuess: document.getElementById("result-guess")!,
				resultActual: document.getElementById("result-actual")!,
				resultRatio: document.getElementById("result-ratio")!,
				resultScore: document.getElementById("result-score")!,
				resultFeedback: document.getElementById("result-feedback")!,
			};

			function shuffle<T>(arr: T[]): T[] {
				const copy = [...arr];
				for (let i = copy.length - 1; i > 0; i--) {
					const j = Math.floor(Math.random() * (i + 1));
					[copy[i], copy[j]] = [copy[j], copy[i]];
				}
				return copy;
			}

			function refillDeck() {
				let next = shuffle(CARDS);
				// avoid immediately repeating the last card seen across reshuffles
				if (previousId && next[0]?.id === previousId && next.length > 1) {
					[next[0], next[1]] = [next[1], next[0]];
				}
				deck = next;
			}

			function drawCard(): GameCard {
				if (deck.length === 0) refillDeck();
				return deck.shift()!;
			}

			function formatUsd(n: number): string {
				return n.toLocaleString("en-US", {
					style: "currency",
					currency: "USD",
					maximumFractionDigits: 0,
				});
			}

			function formatAsOf(iso: string): string {
				return new Date(`${iso}T00:00:00`).toLocaleDateString("en-US", {
					year: "numeric",
					month: "short",
					day: "numeric",
				});
			}

			function feedbackFor(score: number): { text: string; good: boolean } {
				if (score === 100) return { text: "🎯 Nailed it exactly!", good: true };
				if (score >= 85) return { text: "🔥 Incredible guess!", good: true };
				if (score >= STREAK_THRESHOLD) return { text: "👍 Solid guess!", good: true };
				if (score >= 20) return { text: "😬 Not bad, but off.", good: false };
				return { text: "❌ Way off!", good: false };
			}

			function renderCard(card: GameCard) {
				els.art.style.background = `linear-gradient(135deg, ${card.art.from}, ${card.art.to})`;
				els.icon.textContent = card.art.icon;
				els.badge.textContent = `${CATEGORY_LABELS[card.category]} · ${card.year}`;
				els.title.textContent = card.title;
				els.subtitle.textContent = card.subtitle;
				els.guessInput.value = "";
				els.guessInput.disabled = false;
				els.guessBtn.disabled = false;
				els.result.classList.remove("visible");
				els.guessInput.focus();
			}

			function nextRound() {
				current = drawCard();
				previousId = current.id;
				renderCard(current);
			}

			function updateStats(lastScore: number | null) {
				els.score.textContent = lastScore === null ? "–" : String(lastScore);
				els.streak.textContent = `${streak} 🔥`;
				els.best.textContent = String(bestStreak);
			}

			function submitGuess() {
				if (!current) return;
				const raw = els.guessInput.value.trim();
				if (raw === "") {
					els.guessInput.focus();
					return;
				}

				// guess may be garbage (non-numeric, negative, empty) — computeScore
				// and ratioInWords both guard this and never throw or return NaN.
				const guess = Number(raw);
				const validGuess = Number.isFinite(guess) && guess > 0;
				const score = computeScore(guess, current.price);

				els.resultGuess.textContent = validGuess ? formatUsd(guess) : `"${raw}" (invalid)`;
				els.resultActual.textContent = `${formatUsd(current.price)} (as of ${formatAsOf(current.priceAsOf)})`;
				els.resultRatio.textContent = ratioInWords(guess, current.price);
				els.resultScore.textContent = `${score} / 100`;

				const { text, good } = feedbackFor(score);
				els.resultFeedback.textContent = text;
				els.resultFeedback.classList.toggle("good", good);
				els.resultFeedback.classList.toggle("bad", !good);

				els.result.classList.add("visible");
				els.guessInput.disabled = true;
				els.guessBtn.disabled = true;

				streak = score >= STREAK_THRESHOLD ? streak + 1 : 0;
				if (streak > bestStreak) {
					bestStreak = streak;
					localStorage.setItem(BEST_STREAK_KEY, String(bestStreak));
				}
				updateStats(score);
				els.nextBtn.focus();
			}

			els.guessBtn.addEventListener("click", submitGuess);
			els.guessInput.addEventListener("keydown", (e) => {
				if (e.key === "Enter") submitGuess();
			});
			els.nextBtn.addEventListener("click", nextRound);

			updateStats(null);
			nextRound();
		</script>
	</body>
</html>
