---
// "Guess the Price of the Card" — standalone mechanics prototype.
// Uses the starter deck from src/data/cards.ts (real players/sets, estimated
// prices). Swap CARDS for a SportsCardsPro CSV import once that's wired up.
import "../styles/tokens.css";
import { SITE_NAME } from "../lib/site";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={`Guess what this card sold for, see how close you got, and chase a streak — the price-guessing game on ${SITE_NAME}.`} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={`Guess the Price — ${SITE_NAME}`} />
		<title>Guess the Price — {SITE_NAME}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet" />
		<style>
			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				min-height: 100vh;
				background: var(--ink-950);
				color: var(--text);
				font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
				display: flex;
				justify-content: center;
				padding: 2.5rem 1.25rem 4rem;
			}

			main {
				width: 100%;
				max-width: 480px;
			}

			header {
				text-align: center;
				margin-bottom: 1.5rem;
			}

			h1 {
				font-family: "Anton", system-ui, sans-serif;
				font-weight: 400;
				font-size: 2.1rem;
				letter-spacing: 0.01em;
				text-transform: uppercase;
				margin: 0.3rem 0 0.4rem;
				text-shadow: 0 0 1.5rem color-mix(in srgb, var(--accent) 40%, transparent);
			}

			header p {
				color: var(--muted);
				margin: 0;
				font-size: 0.92rem;
			}

			a.back {
				color: var(--muted);
				font-size: 0.85rem;
				text-decoration: none;
			}
			a.back:hover {
				color: var(--text);
			}

			.stats {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.6rem;
				margin: 1.25rem 0;
			}

			.stat {
				background: var(--ink-900);
				border: 1px solid var(--ink-700);
				border-radius: 10px;
				padding: 0.65rem 0.5rem;
				text-align: center;
			}

			.stat .value {
				font-family: "Anton", system-ui, sans-serif;
				font-weight: 400;
				font-size: 1.5rem;
			}

			.stat .value.accent {
				color: var(--accent);
			}

			.stat .value.pulse {
				animation: pop 0.4s ease-out;
			}

			.stat .label {
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--muted);
			}

			.card-panel {
				background: var(--ink-900);
				border: 1px solid var(--ink-700);
				border-radius: 18px;
				overflow: hidden;
				box-shadow: 0 20px 45px -20px rgba(0, 0, 0, 0.6);
			}

			.card-art {
				height: 260px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 5rem;
				position: relative;
				overflow: hidden;
			}

			.card-art::after {
				content: "";
				position: absolute;
				inset: 0;
				background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.4) 50%, transparent 58%);
				transform: translateX(-130%);
			}
			.card-art.shine-play::after {
				animation: shine 1s ease-out;
			}

			.badge {
				position: absolute;
				top: 0.75rem;
				left: 0.75rem;
				background: rgba(0, 0, 0, 0.45);
				padding: 0.25rem 0.6rem;
				border-radius: 999px;
				font-size: 0.72rem;
				letter-spacing: 0.03em;
			}

			.card-body {
				padding: 1.1rem 1.25rem 1.3rem;
			}

			.card-body h2 {
				font-family: "Anton", system-ui, sans-serif;
				font-weight: 400;
				letter-spacing: 0.01em;
				margin: 0 0 0.25rem;
				font-size: 1.4rem;
			}

			.card-body .subtitle {
				color: var(--muted);
				font-size: 0.85rem;
				margin: 0;
			}

			.guess-row {
				display: flex;
				gap: 0.6rem;
				margin-top: 1.1rem;
			}

			.guess-row .prefix {
				display: flex;
				align-items: center;
				padding: 0 0.5rem;
				background: var(--ink-800);
				border: 1px solid var(--ink-700);
				border-radius: 10px 0 0 10px;
				border-right: none;
				color: var(--muted);
			}

			input[type="number"] {
				flex: 1;
				min-width: 0;
				background: var(--ink-800);
				border: 1px solid var(--ink-700);
				border-left: none;
				border-radius: 0 10px 10px 0;
				color: var(--text);
				font-size: 1rem;
				padding: 0.6rem 0.7rem;
			}
			input[type="number"]:focus {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}

			button {
				border: none;
				border-radius: 10px;
				padding: 0.75rem 1rem;
				font-size: 0.95rem;
				font-weight: 700;
				cursor: pointer;
				transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
			}

			#guess-btn {
				margin-top: 0.7rem;
				width: 100%;
				background: var(--accent);
				color: var(--on-accent);
				box-shadow: 0 10px 25px -10px color-mix(in srgb, var(--accent) 70%, transparent);
			}
			#guess-btn:hover:not(:disabled) {
				background: var(--accent-hover);
				transform: translateY(-1px);
			}
			#guess-btn:disabled {
				opacity: 0.5;
				cursor: not-allowed;
				box-shadow: none;
			}

			#next-btn {
				margin-top: 0.7rem;
				width: 100%;
				background: var(--ink-800);
				color: var(--text);
				border: 1px solid var(--ink-700);
			}
			#next-btn:hover {
				border-color: var(--accent);
				transform: translateY(-1px);
			}

			.result {
				margin-top: 1rem;
				border-top: 1px dashed var(--ink-700);
				padding-top: 1rem;
				display: none;
			}

			.result.visible {
				display: block;
			}

			.score-reveal {
				text-align: center;
				margin-bottom: 0.4rem;
				animation: pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1);
			}

			.score-num {
				font-family: "Anton", system-ui, sans-serif;
				font-weight: 400;
				font-size: 3.5rem;
				line-height: 1;
				color: var(--accent);
			}

			.score-reveal.shimmer .score-num {
				background: linear-gradient(90deg, var(--accent), var(--foil-purple), var(--foil-blue), var(--accent));
				background-size: 300% 100%;
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				animation: shimmer 1.8s linear infinite;
			}

			.score-max {
				font-size: 1.1rem;
				color: var(--muted);
			}

			.result-row {
				display: flex;
				justify-content: space-between;
				font-size: 0.9rem;
				margin-bottom: 0.35rem;
			}

			.result-row .val {
				font-weight: 600;
			}

			.feedback {
				text-align: center;
				font-size: 1.05rem;
				font-weight: 700;
				margin: 0.2rem 0 0.9rem;
			}

			.feedback.good {
				color: var(--accent);
			}
			.feedback.bad {
				color: var(--muted);
			}

			.hidden {
				display: none !important;
			}

			@keyframes shine {
				to {
					transform: translateX(130%);
				}
			}

			@keyframes pop {
				from {
					opacity: 0;
					transform: scale(0.85);
				}
				to {
					opacity: 1;
					transform: scale(1);
				}
			}

			@keyframes shimmer {
				to {
					background-position: -300% 0;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.card-art.shine-play::after,
				.score-reveal,
				.stat .value.pulse,
				.score-reveal.shimmer .score-num {
					animation: none;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<header>
				<a class="back" href="/">← {SITE_NAME}</a>
				<h1>🎯 Guess the Price</h1>
				<p>See the card. Guess what it's worth. Chase the streak.</p>
			</header>

			<div class="stats">
				<div class="stat">
					<div class="value" id="stat-score">–</div>
					<div class="label">Last score</div>
				</div>
				<div class="stat">
					<div class="value" id="stat-streak">0 🔥</div>
					<div class="label">Streak</div>
				</div>
				<div class="stat">
					<div class="value" id="stat-best">0</div>
					<div class="label">Best streak</div>
				</div>
			</div>

			<div class="card-panel">
				<div class="card-art" id="card-art">
					<span class="badge" id="card-badge"></span>
					<span id="card-icon"></span>
				</div>
				<div class="card-body">
					<h2 id="card-title"></h2>
					<p class="subtitle" id="card-subtitle"></p>

					<div class="guess-row">
						<span class="prefix">$</span>
						<input
							type="number"
							id="guess-input"
							min="0"
							step="1"
							placeholder="Your guess"
							inputmode="numeric"
						/>
					</div>
					<button id="guess-btn">Lock In Guess</button>

					<div class="result" id="result">
						<div class="score-reveal" id="score-reveal">
							<span class="score-num" id="score-num">0</span><span class="score-max">/100</span>
						</div>
						<p class="feedback" id="result-feedback"></p>
						<div class="result-row">
							<span>Your guess</span>
							<span class="val" id="result-guess"></span>
						</div>
						<div class="result-row">
							<span>The comp</span>
							<span class="val" id="result-actual"></span>
						</div>
						<div class="result-row">
							<span>Ratio</span>
							<span class="val" id="result-ratio"></span>
						</div>
						<button id="next-btn">Next Card →</button>
					</div>
				</div>
			</div>
		</main>

		<script>
			import type { GameCard } from "../data/cards";
			import { drawCard } from "../lib/round";
			import { computeScore, ratioInWords, STREAK_THRESHOLD } from "../lib/scoring";

			const BEST_STREAK_KEY = "cardgame:bestStreak";
			// Score-reveal gets the shimmer treatment (the mascot's iridescent
			// wing colors sweeping across the number) only above this bar — it's
			// a flourish for standout guesses, not every result.
			const SHIMMER_THRESHOLD = 85;

			let current: GameCard | null = null;
			let streak = 0;
			let bestStreak = Number(localStorage.getItem(BEST_STREAK_KEY) ?? "0");

			const els = {
				score: document.getElementById("stat-score")!,
				streak: document.getElementById("stat-streak")!,
				best: document.getElementById("stat-best")!,
				art: document.getElementById("card-art")!,
				badge: document.getElementById("card-badge")!,
				icon: document.getElementById("card-icon")!,
				title: document.getElementById("card-title")!,
				subtitle: document.getElementById("card-subtitle")!,
				guessInput: document.getElementById("guess-input") as HTMLInputElement,
				guessBtn: document.getElementById("guess-btn") as HTMLButtonElement,
				nextBtn: document.getElementById("next-btn") as HTMLButtonElement,
				result: document.getElementById("result")!,
				scoreReveal: document.getElementById("score-reveal")!,
				scoreNum: document.getElementById("score-num")!,
				resultGuess: document.getElementById("result-guess")!,
				resultActual: document.getElementById("result-actual")!,
				resultRatio: document.getElementById("result-ratio")!,
				resultFeedback: document.getElementById("result-feedback")!,
			};

			function formatUsd(n: number): string {
				return n.toLocaleString("en-US", {
					style: "currency",
					currency: "USD",
					maximumFractionDigits: 0,
				});
			}

			function formatAsOf(iso: string): string {
				return new Date(`${iso}T00:00:00`).toLocaleDateString("en-US", {
					year: "numeric",
					month: "short",
					day: "numeric",
				});
			}

			function feedbackFor(score: number): { text: string; good: boolean } {
				if (score === 100) return { text: "🎯 Nailed it exactly!", good: true };
				if (score >= SHIMMER_THRESHOLD) return { text: "🔥 Incredible guess!", good: true };
				if (score >= STREAK_THRESHOLD) return { text: "👍 Solid guess!", good: true };
				if (score >= 20) return { text: "😬 Not bad, but off.", good: false };
				return { text: "❌ Way off!", good: false };
			}

			/** Restarts a CSS animation on an element by forcing a reflow between
			 * removing and re-adding its class — otherwise re-adding a class the
			 * element already has is a no-op and the animation doesn't replay. */
			function replay(el: HTMLElement, className: string) {
				el.classList.remove(className);
				void el.offsetWidth;
				el.classList.add(className);
			}

			function renderCard(card: GameCard) {
				els.art.style.background = `linear-gradient(135deg, ${card.art.from}, ${card.art.to})`;
				els.icon.textContent = card.art.icon;
				els.badge.textContent = `${card.sport} · ${card.condition}`;
				els.title.textContent = card.title;
				els.subtitle.textContent = card.subtitle;
				els.guessInput.value = "";
				els.guessInput.disabled = false;
				els.guessBtn.disabled = false;
				els.result.classList.remove("visible");
				replay(els.art, "shine-play");
				els.guessInput.focus();
			}

			function nextRound() {
				current = drawCard();
				renderCard(current);
			}

			function updateStats(lastScore: number | null, streakJustIncreased: boolean) {
				els.score.textContent = lastScore === null ? "–" : String(lastScore);
				els.streak.textContent = `${streak} 🔥`;
				els.best.textContent = String(bestStreak);
				els.streak.classList.toggle("accent", streak > 0);
				if (streakJustIncreased) replay(els.streak, "pulse");
			}

			function submitGuess() {
				if (!current) return;
				const raw = els.guessInput.value.trim();
				if (raw === "") {
					els.guessInput.focus();
					return;
				}

				// guess may be garbage (non-numeric, negative, empty) — computeScore
				// and ratioInWords both guard this and never throw or return NaN.
				const guess = Number(raw);
				const validGuess = Number.isFinite(guess) && guess > 0;
				const score = computeScore(guess, current.price);

				els.resultGuess.textContent = validGuess ? formatUsd(guess) : `"${raw}" (invalid)`;
				els.resultActual.textContent = `${formatUsd(current.price)} (as of ${formatAsOf(current.priceAsOf)})`;
				els.resultRatio.textContent = ratioInWords(guess, current.price);
				els.scoreNum.textContent = String(score);
				els.scoreReveal.classList.toggle("shimmer", score >= SHIMMER_THRESHOLD);

				const { text, good } = feedbackFor(score);
				els.resultFeedback.textContent = text;
				els.resultFeedback.classList.toggle("good", good);
				els.resultFeedback.classList.toggle("bad", !good);

				// .result flips from display:none to visible here, which is what
				// restarts .score-reveal's pop animation each round — no JS needed.
				els.result.classList.add("visible");
				els.guessInput.disabled = true;
				els.guessBtn.disabled = true;

				const streakIncreased = score >= STREAK_THRESHOLD;
				streak = streakIncreased ? streak + 1 : 0;
				if (streak > bestStreak) {
					bestStreak = streak;
					localStorage.setItem(BEST_STREAK_KEY, String(bestStreak));
				}
				updateStats(score, streakIncreased);
				els.nextBtn.focus();
			}

			els.guessBtn.addEventListener("click", submitGuess);
			els.guessInput.addEventListener("keydown", (e) => {
				if (e.key === "Enter") submitGuess();
			});
			els.nextBtn.addEventListener("click", nextRound);

			updateStats(null, false);
			nextRound();
		</script>
	</body>
</html>
