---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../lib/site";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft && data.date <= new Date());
	return posts.map((post) => ({
		params: { slug: post.data.slug ?? post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date): string {
	return d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout title={`${post.data.title} — ${SITE_NAME}`} description={post.data.excerpt}>
	<a class="back" href="/blog">← all posts</a>

	<article>
		{post.data.heroImage && (
			<img
				class="hero"
				src={post.data.heroImage.src}
				width={post.data.heroImage.width}
				height={post.data.heroImage.height}
				alt=""
			/>
		)}
		<h1>{post.data.title}</h1>
		<p class="meta">
			<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
			{post.data.tags.length > 0 && (
				<span class="tags">
					{post.data.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</span>
			)}
		</p>
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.back {
		display: inline-block;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.85rem;
		margin-bottom: 1.5rem;
	}
	.back:hover {
		color: var(--text);
	}
	.hero {
		width: 100%;
		height: auto;
		border-radius: 12px;
		margin-bottom: 1.5rem;
	}
	article h1 {
		margin: 0 0 0.5rem;
		font-size: 1.8rem;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0 0 1.75rem;
	}
	.tags {
		display: flex;
		gap: 0.4rem;
	}
	.tag {
		background: var(--panel);
		border: 1px solid var(--panel-border);
		border-radius: 999px;
		padding: 0.1rem 0.6rem;
	}
	.prose {
		line-height: 1.7;
		color: #dfe1e6;
	}
	.prose :global(h2) {
		margin-top: 2rem;
		font-size: 1.25rem;
		color: var(--text);
	}
	.prose :global(a) {
		color: var(--accent);
	}
	.prose :global(code) {
		background: var(--panel);
		border: 1px solid var(--panel-border);
		border-radius: 4px;
		padding: 0.1rem 0.35rem;
		font-size: 0.9em;
	}
	.prose :global(ul) {
		padding-left: 1.25rem;
	}
</style>
