# Copy this file to `.env` and fill in the values. `.env` is gitignored; never commit it.
#
# Get both keys from the eBay Developer Program (free):
#   https://developer.ebay.com/my/keys
# Create a keyset and use the PRODUCTION "App ID (Client ID)" and "Cert ID (Client Secret)".
# (The Sandbox keys will not work; this client talks to api.ebay.com.)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Anthropic API key, used by the vision extractor (npm run extract).
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the vision model (default: claude-sonnet-5-5)
# CARD_SCANNER_MODEL=
